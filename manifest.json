{
	"name": "Emoji Box",
	"version": "1.6.95.1688",
	"manifest_version": 3,
	"description": "Can be used to enter emojis, open from menu of the input box.",
	"author": "Yulon",
	"icons": {
		"16": "16.png",
		"48": "48.png",
		"128": "128.png"
	},
	"permissions": [
		"scripting",
		"activeTab",
		"contextMenus"
	],
	"background": {
		"service_worker": "bg.js"
	}
}